{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pest-control-clarity",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "env": {
    "radar-staging": {
      "name": "pest-control-clarity-radar-staging",
      "routes": [
        {
          "pattern": "radar-staging.cloakd-removals.cloud",
          "custom_domain": true
        }
      ]
    }
  }
}
